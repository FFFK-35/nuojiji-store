[{"_eventVersion":4,"importance":2,"topics":["日常","興趣"],"emotion":"playful","openThreads":[],"crossRefs":[],"evidencedFacts":["青桂蛊酒有《无限暖暖》账号且未完成两赛季图鉴","青桂蛊酒2026-10-05直播限定系列卡在第三套皮肤"],"id":1791178322071,"date":"2026-10-05T05:32:02.094Z","summary":"2026-10-05 13:24 起，青桂蛊酒询问今晚安排，确认繁繁无计划后告知自己今晚直播、下午在家吃饭。繁繁随后提出想玩青桂蛊酒的《无限暖暖》账号。青桂蛊酒同意借号，但严厉警告不要“肝穿”账号，因为她还有两个赛季的图鉴未集齐。繁繁质疑其“全收集”的说法，青桂蛊酒承认是吹牛，解释限定系列卡在第三套皮肤，因直播时不肝该游戏导致进度滞后。","startMessageIndex":0,"lastMessageIndex":19,"startMessageId":1791270516280,"endMessageId":1791270516319,"messageCount":19,"dateRange":{"start":"2026-10-05 13:24","end":"2026-10-05 13:31"},"source":"online","keywords":["无限暖暖","借号","今晚直播","肝穿","图鉴","限定皮肤","2026-10-05 13:24","2026-10-05 13:31"],"timeline":[{"ts":1791178079941,"who":"char","text":"确认今晚直播，下午在家吃饭"},{"ts":1791178190758,"who":"char","text":"同意将《无限暖暖》账号借给繁繁"},{"ts":1791178198613,"who":"char","text":"警告繁繁不要“肝穿”账号"}],"obsoleteFacts":[],"loveJourneyEntries":null,"achievementEntries":null,"customRange":null,"__v4StanceText":"愿意分享游戏乐趣，但对账号进度有点护短，怕被玩坏。","__relationalGrowthText":null,"__selfGrowthText":null,"__growthText":null,"plotThreadId":1791178322071,"userId":"uid_1790095041048_k0914pvjl","characterId":"b79adb79-e1e2-4001-970e-72a73bfeef0d"},{"_eventVersion":4,"importance":2,"topics":["日常","興趣"],"emotion":"playful","openThreads":[],"crossRefs":[],"evidencedFacts":["青桂蛊酒《第五人格》第三套皮肤卡点近两个月","青桂蛊酒直播计划含挂机暖暖"],"id":1791178589239,"date":"2026-10-05T05:36:29.267Z","summary":"[事件范围: 24-46]\n2026-10-05 13:32，青桂蛊酒提议直播《第五人格》，计划前两小时肝游戏，后续视状态挂机暖暖。她将账号密码发给繁繁，但严格限制“只许穿、不许肝”，因第三套皮肤已卡了近两个月，她急需完成以穿出去展示。繁繁调侃游戏比自己重要，青桂蛊酒笑称是“第三套皮肤比繁繁重要”，并建议繁繁若非要上线就只查看不操作，否则等她晚上自行肝完再给繁繁看成品图。","startMessageIndex":23,"lastMessageIndex":46,"startMessageId":1791270516320,"endMessageId":1791270516350,"messageCount":23,"dateRange":{"start":"2026-10-05 13:32","end":"2026-10-05 13:36"},"source":"online","keywords":["第五人格","皮肤","只许穿","不许肝","密码","截图","暖暖","2026-10-05 13:32","2026-10-05 13:36"],"timeline":[{"ts":1791178434474,"tsEnd":1791178438439,"wh