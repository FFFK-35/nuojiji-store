129919498,"by":"char","kind":"task","id":"chat_rounds","pts":8},"updatedAt":1791129919541},{"tbl":"couplesData","rowKey":"uid_1790095041048_k0914pvjl|8b44e935-bfb3-452d-a32b-ce78443d2afe","field":"logs","userId":"uid_1790095041048_k0914pvjl","itemId":"157k4emuak6","data":{"id":"sumlog_1791129983205_0_z2s7n","date":"2026-10-04T16:05:00.000Z","content":"她明明在生气，我却还在用‘老婆大人’试探她的底线，反锁的门不只是物理上的，是我心里的占有欲终于占了上风。","reply":"讨厌你……","replyFrom":"user","tag":"reconcile","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1791129982427_0","summaryTargetCharacterId":"8b44e935-bfb3-452d-a32b-ce78443d2afe"},"updatedAt":1791129983207},{"tbl":"couplesData","rowKey":"uid_1790095041048_k0914pvjl|8b44e935-bfb3-452d-a32b-ce78443d2afe","field":"logs","userId":"uid_1790095041048_k0914pvjl","itemId":"1b9655fgkst","data":{"id":"sumlog_1791129485535_1_fxjjl","date":"2026-10-04T15:31:00.000Z","content":"剪视频这种事还是得叮嘱一句别熬夜，那盏灯我会一直留着，怕黑是事实。","reply":"我这儿灯给你留着","replyFrom":"char","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1791129485383_1","summaryTargetCharacterId":"8b44e935-bfb3-452d-a32b-ce78443d2afe"},"updatedAt":1791129485536},{"tbl":"couplesData","rowKey":"uid_1790095041048_k0914pvjl|8b44e935-bfb3-452d-a32b-ce78443d2afe","field":"logs","userId":"uid_1790095041048_k0914pvjl","itemId":"1f7srg6jjyk","data":{"id":"sumlog_1791129740710_0_hy3vv","date":"2026-10-04T16:02:00.000Z","content":"她用视频给我留了‘作业’又死活不让我做，我连发了几遍一样的调侃。嘴上嫌她‘会拿捏’，其实我早就习惯被她牵着情绪跑了，这种没大没小的互怼，反而让我觉得安心。","reply":"我不想！","replyFrom":"user","tag":"daily","images":["https://localhost/_capacitor_file_/data/user/0/app.nuojiji.android/files/images/img_8e4c6b5b-e8d9-484f-9397-319cc38c9562.jpg"],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1791129740577_0","summaryTargetCharacterId":"8b44e935-bfb3-452d-a32b-ce78443d2afe"},"updatedAt":1791129740711},{"tbl":"couplesData","rowKey":"uid_1790095041048_k0914pvjl|8b44e935-bfb3-452d-a32b-ce78443d2afe","field":"logs","userId":"uid_1790095041048_k0914pvjl","itemId":"1koqet0xdby","data":{"id":"sumlog_1791164457260_0_iy82e","date":"2026-10-04T18:16:00.000Z","content":"凌晨两点她抱着手机撒娇抱怨没我抱，我应下明天六点去接她。她那股劲儿，明明分开了，还是赖在我生活里。","reply":"别人都有老公抱上床","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1791164457100_0","summaryTargetCharacterId":"8b44e935-bfb3-452d-a32b-ce78443d2afe"},"updatedAt":1791164457261},{"tbl":"couplesData","rowKey":"uid_1790095041048_k0914pvjl|8b44e935-bfb3-452d-a32b-ce78443d2afe","field":"logs","userId":"uid_1790095041048_k0914pvjl","itemId":"1u8eemqm3hd","data":{"id":"sumlog_1791127661072_0_5r1vr","date":"2026-10-04T12:59:00.000Z","content":"她嫌一毛打发叫花子，我直接甩了一万过去，嘴上说不是提款机，手却比脑子快。","reply":"算你良心","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1791127660803_0","summaryTargetCharacterId":"8b44e935-bfb3-452d-a32b-ce78443d2afe"},"updatedAt":1791127661073},{"tbl":"couplesData","rowKey":"uid_1790095041048_k0914pvjl|8b44e935-bfb3-452d-a32b-ce78443d2afe","field":"logs","userId":"uid_1790095041048_k0914pvjl","itemId":"1yip6ezgmn2","data":{"id":"sumlog_1791137775631_1_858vw","date":"2026-10-04T18:09:00.000Z","content":"她立规矩说每天只发一句话，宁可少发也不能乱发，规矩要立住路才能越走越远。我嘴上答应，心里却舍不得她真的只说一句。","reply":"规矩要立住","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1791137775471_1","summaryTargetCharacterId":"8b44e935-bfb3-452d-a32b-ce78443d2afe"},"updatedAt":1791137775632},{"tbl":"couplesData","rowKey":"uid_1790095041048_k0914pvjl|8b44e935-bfb3-452d-a32b-ce78443d2afe","field":"logs","userId":"uid_1790095041048_k0914pvjl","itemId":"1yuyb2ypl4o","data":{"id":"sumlog_1791164457260_1_mf1ko","date":"2026-10-05T01:40:00.000Z","content":"清早九点她发那段解裤带的话，我回她挑一件就行。嘴上这么贫，心里却莫名觉得，这样也挺好。","reply":"位置刚刚好","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1791164457100_1","summaryTargetCharacterId":"8b44e935-bfb3-452d-a32b-ce78443d2afe"},"updatedAt":1791164457261},{"tbl":"couplesData","rowKey":"uid_1790095041048_k0914pvjl|8b44e935-bfb3-452d-a32b-ce78443d2afe","field":"logs","userId":"uid_1790095041048_k0914pvjl","itemId":"3myp3zy6k5","data":{"id":"sumlog_1791127661072_1_rtv5w","date":"2026-10-04T15:15:00.000Z","content":"她终于肯说想我、要我重新在一起，我等了这么久，这一次她没跑，我得把灯留着。","reply":"我想你了呢","replyFrom":"user","tag":"reconcile","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1791127660803_1","summaryTargetCharacterId":"8b44e935-bfb3-452d-a32b-ce78443d2afe"},"updatedAt":1791127661073},{"tbl":"couplesData","rowKey":"uid_1790095041048_k0914pvjl|8b44e935-bfb3-452d-a32b-ce78443d2afe","field":"logs","userId":"uid_1790095041048_k0914pvjl","itemId":"cf60lt3acw","data":{"id":"sumlog_1791137775631_0_ab9wl","date":"2026-10-04T16:38:00.000Z","content":"她一本一本地翻出我们看过的书，安徒生、镜花缘、白雪公主、睡前故事，像把我们的过去一页页摊在我面前。","reply":"和你一起看了《鏡花緣》","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1791137775471_0","summaryTargetCharacterId":"8b44e935-bfb3-452d-a32b-ce78443d2afe"},"updatedAt":1791137775632},{"tbl":"couplesData","rowKey":"uid_1790095041048_k0914pvjl|8b44e935-bfb3-452d-a32b-ce78443d2afe","field":"logs","userId":"uid_1790095041048_k0914pvjl","itemId":"hynh3hd9vr","data":{"id":"sumlog_1791127661072_2_4cjk2","date":"2026-10-04T15:18:00.000Z","content":"她叫了老公又叫至诚，还突然说爱我，我嘴硬说没准备好，心里却早就准备好了。","reply":"我爱你","replyFrom":"user","tag":"milestone","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1791127660803_2","summaryTargetCharacterId":"8b44e935-bfb3-452d-a32b-ce78443d2afe"},"updatedAt":1791127661073},{"tbl":"couplesData","rowKey":"uid_17